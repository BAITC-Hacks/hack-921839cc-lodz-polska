# Explicit demo mode. No AI requests or simulation engine run in the browser.
NEXT_PUBLIC_API_MODE=mock
# In live mode: backend origin (without /api), or empty for same-origin routing.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Agreed /api/recommend endpoint. Enabled by default in live mode; false opts out.
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
# Proposed /api/ai/compare contract in INTEGRATION.md; keep false until implemented.
NEXT_PUBLIC_ENABLE_AI_COMPARISON=false
